{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "com.jan.musiccast",
	"Name": "MusicCast Volume",
	"Version": "0.1.0.0",
	"Author": "Jan",
	"Description": "Control the volume of Yamaha MusicCast speakers with Stream Deck + dials.",
	"Icon": "imgs/plugin",
	"Category": "MusicCast Volume",
	"CategoryIcon": "imgs/action",
	"SDKVersion": 3,
	"Software": { "MinimumVersion": "6.9" },
	"OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
	"Nodejs": { "Version": "20", "Debug": "enabled" },
	"CodePath": "bin/plugin.js",
	"Actions": [
		{
			"UUID": "com.jan.musiccast.volume",
			"Name": "Speaker Volume",
			"Tooltip": "Rotate to change volume, press to mute.",
			"Icon": "imgs/action",
			"Controllers": ["Encoder"],
			"States": [{ "Image": "imgs/key" }],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Volume",
					"Push": "Mute / unmute"
				}
			},
			"PropertyInspectorPath": "ui/property-inspector.html"
		}
	]
}
